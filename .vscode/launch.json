{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Haggis Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.Infrastructure",
      "program": "${workspaceFolder}/haggis-platform/backend/src/Haggis.Infrastructure/bin/Debug/net9.0/Haggis.Infrastructure.dll",
      "args": [],
      "cwd": "${workspaceFolder}/haggis-platform/backend/src/Haggis.Infrastructure",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:6666"
      }
    },
    {
      "name": "Flutter Android 1",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/haggis-platform/client/haggis_flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/haggis-platform/client/haggis_flutter",
      "deviceId": "emulator-5554",
      "preLaunchTask": "start Android Emulator 1"
    },
    {
      "name": "Flutter Android 2",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/haggis-platform/client/haggis_flutter/lib/main.dart",
      "cwd": "${workspaceFolder}/haggis-platform/client/haggis_flutter",
      "deviceId": "emulator-5556",
      "preLaunchTask": "start Android Emulator 2"
    }
  ],
  "compounds": [
    {
      "name": "Backend + 2 Android Emulators",
      "configurations": [
        "Haggis Backend (.NET)",
        "Flutter Android 1",
        "Flutter Android 2"
      ],
      "stopAll": true
    }
  ]
}
