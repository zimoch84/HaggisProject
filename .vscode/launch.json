{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Haggis Backend (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.Infrastructure",
      "program": "${workspaceFolder}/haggis-platform/backend/src/Haggis.Infrastructure/bin/Debug/net9.0/Haggis.Infrastructure.dll",
      "args": [],
      "cwd": "${workspaceFolder}/haggis-platform/backend/src/Haggis.Infrastructure",
      "stopAtEntry": false,
      "console": "internalConsole",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:6666"
      }
    },
    {
      "name": "Haggis Game Engine Tests (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build HaggisTests",
      "program": "dotnet",
      "args": [
        "test",
        "${workspaceFolder}/haggis-platform/backend/tests/Game.Engine.Tests/HaggisTests.csproj",
        "--no-build"
      ],
      "cwd": "${workspaceFolder}",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Haggis AI Benchmark - normal vs normal",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.AiBenchmark",
      "program": "${workspaceFolder}/haggis-platform/backend/tools/Haggis.AiBenchmark/bin/Debug/net8.0/Haggis.AiBenchmark.dll",
      "args": [
        "--games=100",
        "--players=3",
        "--seed-start=1",
        "--game-over-score=250",
        "--ai1=normal",
        "--ai2=normal",
        "--ai3=normal",
        "--rotate=true",
        "--max-moves=10000",
        "--log=outcomes.txt",
        "--csv=results.csv"
      ],
      "cwd": "${workspaceFolder}/haggis-platform/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Haggis AI Benchmark - normal vs random+normal",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.AiBenchmark",
      "program": "${workspaceFolder}/haggis-platform/backend/tools/Haggis.AiBenchmark/bin/Debug/net8.0/Haggis.AiBenchmark.dll",
      "args": [
        "--games=100",
        "--players=3",
        "--seed-start=1",
        "--game-over-score=250",
        "--ai1=normal",
        "--ai2=random",
        "--ai3=normal",
        "--rotate=true",
        "--max-moves=10000",
        "--log=outcomes.txt",
        "--csv=results.csv"
      ],
      "cwd": "${workspaceFolder}/haggis-platform/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Haggis AI Benchmark - normal vs heuristic-continuations+normal",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.AiBenchmark",
      "program": "${workspaceFolder}/haggis-platform/backend/tools/Haggis.AiBenchmark/bin/Debug/net8.0/Haggis.AiBenchmark.dll",
      "args": [
        "--games=100",
        "--players=3",
        "--seed-start=1",
        "--game-over-score=250",
        "--ai1=normal",
        "--ai2=heuristic-continuations",
        "--ai3=normal",
        "--rotate=true",
        "--max-moves=10000",
        "--log=outcomes.txt",
        "--csv=results.csv"
      ],
      "cwd": "${workspaceFolder}/haggis-platform/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Haggis AI Benchmark - normal vs montecarlo vs random",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.AiBenchmark",
      "program": "${workspaceFolder}/haggis-platform/backend/tools/Haggis.AiBenchmark/bin/Debug/net8.0/Haggis.AiBenchmark.dll",
      "args": [
        "--games=4",
        "--players=3",
        "--seed-start=1",
        "--game-over-score=250",
        "--ai1=normal",
        "--ai2=montecarlo:200:200:4",
        "--ai3=random",
        "--rotate=true",
        "--max-moves=10000",
        "--log=outcomes.txt",
        "--csv=results.csv"
      ],
      "cwd": "${workspaceFolder}/haggis-platform/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Haggis MCTS Run Analyzer",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Haggis.MctsRunAnalyzer",
      "program": "${workspaceFolder}/haggis-platform/backend/tools/Haggis.MctsRunAnalyzer/bin/Debug/net8.0/Haggis.MctsRunAnalyzer.dll",
      "args": [
        "--seed=1",
        "--ai1=montecarlo",
        "--ai2=normal",
        "--ai3=random",
        "--iterations=5",
        "--timebudget=100",
        "--workers=1",
        "--output=logs/mcts-run.txt"
      ],
      "cwd": "${workspaceFolder}/haggis-platform/backend",
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "Flutter Android 1",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/haggis-platform/client/Haggis.Flutter.UI",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "emulator-5554",
      "preLaunchTask": "start Android Emulator 1"
    },
    {
      "name": "Flutter Android 2",
      "type": "dart",
      "request": "launch",
      "cwd": "${workspaceFolder}/haggis-platform/client/Haggis.Flutter.UI",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "deviceId": "emulator-5556",
      "preLaunchTask": "start Android Emulator 2"
    }
  ],
  "compounds": [
    {
      "name": "2 Flutter Android Apps Debug",
      "configurations": [
        "Flutter Android 1",
        "Flutter Android 2"
      ],
      "stopAll": true
    },
    {
      "name": "Backend + 2 Flutter Android Apps",
      "configurations": [
        "Haggis Backend (.NET)",
        "Flutter Android 1",
        "Flutter Android 2"
      ],
      "stopAll": true
    }
  ]
}
