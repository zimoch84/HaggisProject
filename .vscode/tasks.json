{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build Haggis.ConsoleUI",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/haggis-platform/client/Haggis.ConsoleUI/HaggisRuntime.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Serwer.API",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/haggis-platform/backend/src/Serwer.API/Serwer.API.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Haggis.Infrastructure",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/haggis-platform/backend/src/Haggis.Infrastructure/Haggis.Infrastructure.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build HaggisTests",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/haggis-platform/backend/tests/Game.Engine.Tests/HaggisTests.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Haggis.AiBenchmark",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/haggis-platform/backend/tools/Haggis.AiBenchmark/Haggis.AiBenchmark.csproj",
        "--no-restore"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build Haggis.MctsRunAnalyzer",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/haggis-platform/backend/tools/Haggis.MctsRunAnalyzer/Haggis.MctsRunAnalyzer.csproj"
      ],
      "problemMatcher": "$msCompile"
    },
  {
    "label": "start Android Emulator 1",
    "type": "shell",
    "command": "powershell",
    "args": [
      "-NoProfile",
      "-ExecutionPolicy",
      "Bypass",
      "-Command",
      "flutter emulators --launch Medium_Phone_API_36.1; Start-Sleep -Seconds 10"
    ],
    "problemMatcher": []
    },
    {
      "label": "start Android Emulator 2",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-Command",
        "$sdk = Join-Path $env:LOCALAPPDATA 'Android\\sdk'; $emulator = Join-Path $sdk 'emulator\\emulator.exe'; $adb = Join-Path $sdk 'platform-tools\\adb.exe'; $device = 'emulator-5556'; if (-not (& $adb devices | Select-String $device)) { Start-Process $emulator -ArgumentList '-avd','Medium_Phone_API_36.1_2','-port','5556'; } & $adb -s $device wait-for-device; do { Start-Sleep -Seconds 2; $boot = (& $adb -s $device shell getprop sys.boot_completed 2>$null).Trim(); } while ($boot -ne '1')"
      ],
      "problemMatcher": []
    }
  ]
}
